# Instalacion comercial que sigue siendo local a una sola PC.
# Copia este archivo como .env en la raiz del proyecto y reemplaza secretos.
# Luego ejecuta: docker compose up -d --build

POSTGRES_PASSWORD=reemplaza-esto-por-una-password-fuerte
APP_DB_PASSWORD=reemplaza-esto-por-otra-password-fuerte-y-distinta
JWT_SECRET=reemplaza-esto-por-una-cadena-aleatoria-de-32-caracteres-o-mas
BOOTSTRAP_ADMIN_PASSWORD=ReemplazaEstaClaveInicial2026

TECHSTORE_MODE=commercial-local
COMPOSE_PROFILES=commercial-local
SPRING_PROFILES_ACTIVE=prod
SPRINGDOC_ENABLED=false
PUBLIC_BASE_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Ningun servicio se expone a la red local: solo acepta conexiones de esta PC.
POSTGRES_BIND_ADDRESS=127.0.0.1
BACKEND_BIND_ADDRESS=127.0.0.1
FRONTEND_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432
BACKEND_PORT=8090
FRONTEND_PORT=5173

DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILES=5
