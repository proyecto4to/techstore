# Variables de entorno para docker-compose.
# Copia este archivo como .env (queda ignorado por git) y reemplaza los valores.
# Deben ser los MISMOS valores que uses en secrets.local.ps1 si alternás entre
# Docker y el modo manual/portable.

POSTGRES_PASSWORD=reemplaza-esto-por-una-password-fuerte
JWT_SECRET=reemplaza-esto-por-una-cadena-aleatoria-de-32-caracteres-o-mas
