# Variables para docker-compose. Copia este archivo como .env (ignorado por git).
# TECHSTORE_MODE y COMPOSE_PROFILES siempre deben tener exactamente el mismo valor.
# "local" mantiene Vite con recarga. Para vender una instalacion local estable,
# usa la plantilla docker/env/commercial-local.env.example. "commercial" publica
# el build nginx detras de un proxy HTTPS.
# Nunca reutilices la contraseña administrativa como contraseña de la aplicación.

POSTGRES_PASSWORD=reemplaza-esto-por-una-password-fuerte
APP_DB_PASSWORD=reemplaza-esto-por-otra-password-fuerte-y-distinta
JWT_SECRET=reemplaza-esto-por-una-cadena-aleatoria-de-32-caracteres-o-mas

TECHSTORE_MODE=local
COMPOSE_PROFILES=local
SPRING_PROFILES_ACTIVE=dev
SPRINGDOC_ENABLED=true
PUBLIC_BASE_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Por defecto nada queda publicado hacia la red local. Un proxy HTTPS comercial
# puede apuntar al FRONTEND_BIND_ADDRESS/FRONTEND_PORT expresamente configurados.
POSTGRES_BIND_ADDRESS=127.0.0.1
BACKEND_BIND_ADDRESS=127.0.0.1
FRONTEND_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432
BACKEND_PORT=8090
FRONTEND_PORT=5173

# Rotacion de los logs json de cada contenedor (evita llenar el disco).
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILES=5
PUSH_PROVIDER=
EXPO_PUSH_URL=
EXPO_ACCESS_TOKEN=

# Entrega asíncrona de notificaciones (Transactional Outbox)
NOTIFICATION_OUTBOX_ENABLED=true
NOTIFICATION_OUTBOX_POLL_INTERVAL_MS=5000
NOTIFICATION_OUTBOX_INITIAL_DELAY_MS=10000
NOTIFICATION_OUTBOX_BATCH_SIZE=20
NOTIFICATION_OUTBOX_MAX_ATTEMPTS=5
NOTIFICATION_OUTBOX_BASE_RETRY_SECONDS=30
NOTIFICATION_OUTBOX_MAX_RETRY_SECONDS=21600
NOTIFICATION_OUTBOX_STALE_AFTER_SECONDS=900
