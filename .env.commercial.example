# Copia como .env.commercial, reemplaza todos los placeholders y usa:
# docker compose --env-file .env.commercial up -d --build
# El proxy HTTPS del host debe publicar PUBLIC_BASE_URL y apuntar a 127.0.0.1:5173.

POSTGRES_PASSWORD=reemplaza-esto-por-una-password-fuerte
APP_DB_PASSWORD=reemplaza-esto-por-otra-password-fuerte-y-distinta
JWT_SECRET=reemplaza-esto-por-una-cadena-aleatoria-de-32-caracteres-o-mas
BOOTSTRAP_ADMIN_PASSWORD=ReemplazaEstaClaveInicial2026

TECHSTORE_MODE=commercial
COMPOSE_PROFILES=commercial
SPRING_PROFILES_ACTIVE=prod
SPRINGDOC_ENABLED=false
PUBLIC_BASE_URL=https://tienda.example.com
CORS_ALLOWED_ORIGINS=https://tienda.example.com

POSTGRES_BIND_ADDRESS=127.0.0.1
BACKEND_BIND_ADDRESS=127.0.0.1
FRONTEND_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432
BACKEND_PORT=8090
FRONTEND_PORT=5173

DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILES=5
